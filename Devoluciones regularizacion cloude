    if(f.modelo&&!r.modelo?.toLowerCase().includes(f.modelo.toLowerCase()))return false;
    if(f.fD&&r.fechaAdjunto<f.fD)return false;
    if(f.fH&&r.fechaAdjunto>f.fH)return false;
    if(f.q){const q=f.q.toLowerCase();return[r.tienda,r.proveedor,r.nroGuia,r.nroCartaPorte,r.nc,r.serie,r.modelo,r.uploadedBy,r.uploadedEmail].some(v=>v?.toLowerCase().includes(q));}

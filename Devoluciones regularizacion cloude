            </div>
          </div>
        </div>
      )}
    </div>
  );
}

// ── Cruce SAP ──────────────────────────────────────────────────────────────
function CruceSAP({records}){
  const [sapRows,setSap]=useState(null);
  const [headers,setHdrs]=useState([]);
  const [cpCol,setCpCol]=useState('');
  const [results,setRes]=useState(null);
  const [view,setView]=useState('all');
  const ref=useRef();

  const loadXLS=e=>{
    const file=e.target.files[0];if(!file)return;
    const reader=new FileReader();
    reader.onload=ev=>{
      try{
        const wb=XLSX.read(ev.target.result,{type:'binary'});
        const ws=wb.Sheets[wb.SheetNames[0]];
        const raw=XLSX.utils.sheet_to_json(ws,{header:1});
        if(raw.length<2){alert('Archivo sin datos suficientes.');return;}
        const hdrs=raw[0].map(h=>String(h!=null?h:''));
        const rows=raw.slice(1).map(row=>Object.fromEntries(hdrs.map((h,i)=>[h,row[i]!=null?row[i]:'']))).filter(row=>Object.values(row).some(v=>v!==''));
        setHdrs(hdrs);setSap(rows);setRes(null);
        const auto=hdrs.find(h=>/carta|porte|cp\b/i.test(h));
        setCpCol(auto||hdrs[0]||'');
      }catch{alert('Error al leer el Excel.');}
    };
    reader.readAsBinaryString(file);e.target.value='';
  };

  const run=()=>{
    const cps=new Set(records.map(r=>r.nroCartaPorte?r.nroCartaPorte.trim().toLowerCase():''));
    const crossed=sapRows.map(row=>{
      const cp=String(row[cpCol]!=null?row[cpCol]:'').trim();
      const ok=cp!==''&&cps.has(cp.toLowerCase());
      const match=records.find(r=>r.nroCartaPorte&&r.nroCartaPorte.trim().toLowerCase()===cp.toLowerCase());
      return{...row,_cp:cp,_ok:ok,_tienda:match?match.tienda:'—',_prov:match?match.proveedor:'—',_guia:match?match.nroGuia:'—'};
    });
    setRes(crossed);setView('all');
  };

  const exportXLS=()=>{
    if(!results)return;
    const wb=XLSX.utils.book_new();
    const prep=arr=>arr.map(r=>{
      const out={ESTADO:r._ok?'CON SUSTENTO':'SIN SUSTENTO','CARTA PORTE':r._cp,TIENDA:r._tienda,PROVEEDOR:r._prov,'NRO GUIA':r._guia};
      Object.keys(r).filter(k=>!k.startsWith('_')).forEach(k=>{out[k]=r[k];});
      return out;
    });
    XLSX.utils.book_append_sheet(wb,XLSX.utils.json_to_sheet(prep(results)),'Cruce Completo');
    XLSX.utils.book_append_sheet(wb,XLSX.utils.json_to_sheet(prep(results.filter(r=>r._ok))),'Con Sustento');
    XLSX.utils.book_append_sheet(wb,XLSX.utils.json_to_sheet(prep(results.filter(r=>!r._ok))),'Sin Sustento');
    XLSX.writeFile(wb,'Cruce_SAP_'+new Date().toISOString().slice(0,10)+'.xlsx');
  };

  const shown=results?(view==='all'?results:results.filter(r=>view==='con'?r._ok:!r._ok)):[];
  const nCon=results?results.filter(r=>r._ok).length:0;
  const nSin=results?results.filter(r=>!r._ok).length:0;

  return(
    <div>
      <div style={{...cardS,marginBottom:20}}>
        <div style={hdS}>
          <h2 style={{margin:0,fontSize:17,fontWeight:800}}>🔄 Cruce SAP con Sustentos</h2>
          <p style={{margin:'3px 0 0',fontSize:12,opacity:.8}}>Cargue el Excel de SAP y cruce por Nro. Carta Porte.</p>
        </div>
        <div style={{padding:24}}>
          <div style={{marginBottom:16,padding:16,background:'#f8fafc',borderRadius:8,border:'1px solid #e5e7eb'}}>
            <p style={{margin:'0 0 10px',fontWeight:800,color:BL,fontSize:13}}>1️⃣ Cargar Excel exportado de SAP</p>
            <div style={{display:'flex',alignItems:'center',gap:12}}>
              <button onClick={()=>ref.current&&ref.current.click()} style={{padding:'10px 20px',background:BL,color:'white',border:'none',borderRadius:8,cursor:'pointer',fontWeight:700,fontFamily:'inherit'}}>📂 Seleccionar Excel</button>
              <input ref={ref} type="file" accept=".xlsx,.xls" onChange={loadXLS} style={{display:'none'}}/>
              {sapRows&&<span style={{color:'#22c55e',fontWeight:700,fontSize:13}}>✅ {sapRows.length} registros cargados</span>}
            </div>
          </div>
          {sapRows&&(
            <>
              <div style={{marginBottom:16,padding:16,background:'#f8fafc',borderRadius:8,border:'1px solid #e5e7eb'}}>
                <p style={{margin:'0 0 10px',fontWeight:800,color:BL,fontSize:13}}>2️⃣ Columna de Carta Porte en el Excel SAP</p>
                <select value={cpCol} onChange={e=>setCpCol(e.target.value)} style={{padding:'10px 12px',border:'1.5px solid #d1d5db',borderRadius:6,fontSize:13,minWidth:280,fontFamily:'inherit'}}>
                  {headers.map(h=><option key={h}>{h}</option>)}
                </select>
              </div>
              <div style={{padding:16,background:'#f8fafc',borderRadius:8,border:'1px solid #e5e7eb'}}>
                <p style={{margin:'0 0 10px',fontWeight:800,color:BL,fontSize:13}}>3️⃣ Ejecutar el cruce</p>
                <button onClick={run} style={{padding:'12px 32px',background:'linear-gradient(135deg,'+BL+','+BL2+')',color:'white',border:'none',borderRadius:8,cursor:'pointer',fontWeight:800,fontSize:15,fontFamily:'inherit'}}>▶ EJECUTAR CRUCE</button>
              </div>
            </>
          )}
        </div>
      </div>

      {results&&(
        <div style={cardS}>
          <div style={{padding:'16px 20px',borderBottom:'1px solid #f3f4f6'}}>
            <div style={{display:'grid',gridTemplateColumns:'1fr 1fr 1fr',gap:12,marginBottom:16}}>
              {[{l:'✅ Con Sustento',v:nCon,bg:'#dcfce7',fg:'#166534'},{l:'❌ Sin Sustento',v:nSin,bg:'#fee2e2',fg:'#dc2626'},{l:'📊 Total SAP',v:results.length,bg:'#dbeafe',fg:'#1e40af'}].map(s=>(
                <div key={s.l} style={{background:s.bg,borderRadius:8,padding:14,textAlign:'center'}}>
                  <div style={{fontSize:28,fontWeight:900,color:s.fg}}>{s.v}</div>
                  <div style={{color:s.fg,fontWeight:700,fontSize:12}}>{s.l}</div>
                </div>
              ))}
            </div>
            <div style={{display:'flex',gap:8,alignItems:'center',flexWrap:'wrap'}}>
              {[['all','Todos'],['con','Con Sustento'],['sin','Sin Sustento']].map(([k,l])=>(
                <button key={k} onClick={()=>setView(k)} style={{padding:'7px 14px',background:view===k?BL:'white',color:view===k?'white':'#374151',border:'1.5px solid '+(view===k?BL:'#d1d5db'),borderRadius:6,cursor:'pointer',fontSize:12,fontWeight:700,fontFamily:'inherit'}}>{l}</button>
              ))}
              <button onClick={exportXLS} style={{marginLeft:'auto',padding:'7px 16px',background:'#166534',color:'white',border:'none',borderRadius:6,cursor:'pointer',fontSize:12,fontWeight:700,fontFamily:'inherit'}}>📥 Exportar a Excel</button>
            </div>
          </div>
          <div style={{overflowX:'auto',maxHeight:380,overflowY:'auto'}}>
            <table style={{width:'100%',borderCollapse:'collapse',minWidth:500}}>
              <thead style={{position:'sticky',top:0,zIndex:1}}>
                <tr style={{background:'#f8fafc',borderBottom:'2px solid #e5e7eb'}}>
                  {['Estado','Carta Porte (SAP)','Tienda','Proveedor','Nro. Guía'].map(h=>(
                    <th key={h} style={{padding:'10px 12px',textAlign:'left',color:'#374151',fontWeight:800,fontSize:11,whiteSpace:'nowrap'}}>{h}</th>
                  ))}
                </tr>
              </thead>
              <tbody>
                {shown.map((r,i)=>(
                  <tr key={i} style={{background:r._ok?'#f0fdf4':'#fff5f5',borderBottom:'1px solid #f3f4f6'}}>
                    <td style={{padding:'9px 12px'}}><span style={{background:r._ok?'#dcfce7':'#fee2e2',color:r._ok?'#166534':'#dc2626',padding:'3px 10px',borderRadius:20,fontSize:11,fontWeight:800}}>{r._ok?'✅ CON SUSTENTO':'❌ SIN SUSTENTO'}</span></td>
                    <td style={{padding:'9px 12px',fontFamily:'monospace',fontWeight:700,color:'#1e40af',fontSize:13}}>{r._cp||'—'}</td>
                    <td style={{padding:'9px 12px',fontSize:13}}>{r._tienda}</td>
                    <td style={{padding:'9px 12px',fontSize:13}}>{r._prov}</td>
                    <td style={{padding:'9px 12px',fontFamily:'monospace',fontSize:13}}>{r._guia}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      )}
    </div>
  );
}

// ── Admin ──────────────────────────────────────────────────────────────────
function Admin({tiendas,provs,saveT,saveP,contacts,saveCont,users,pending,onApprove,onReject,notify}){
  const [at,setAt]=useState('tiendas');
  const [approvePw,setAPw]=useState({});
  const ATABS=[{k:'tiendas',l:'🏪 Tiendas'},{k:'provs',l:'🏭 Proveedores'},{k:'contacts',l:'📞 Contactos'},{k:'pending',l:'📩 Solicitudes'+(pending.length>0?' ('+pending.length+')':'')},{k:'users',l:'👥 Usuarios'}];

  return(
    <div style={cardS}>
      <div style={hdS}><h2 style={{margin:0,fontSize:17,fontWeight:800}}>⚙️ Panel de Administración</h2></div>
      <div style={{display:'flex',borderBottom:'1px solid #e5e7eb',background:'#f8fafc',overflowX:'auto'}}>
        {ATABS.map(t=>(
          <button key={t.k} onClick={()=>setAt(t.k)} style={{padding:'12px 18px',border:'none',background:at===t.k?'white':'transparent',borderBottom:at===t.k?'2px solid '+BL2:'2px solid transparent',cursor:'pointer',fontSize:13,fontWeight:at===t.k?700:400,color:at===t.k?BL2:'#6b7280',fontFamily:'inherit',whiteSpace:'nowrap'}}>{t.l}</button>
        ))}
      </div>
      <div style={{padding:24}}>
        {at==='tiendas'&&<ListMgr items={tiendas} onSave={saveT} notify={notify} singular="tienda"/>}
        {at==='provs'&&<ListMgr items={provs} onSave={saveP} notify={notify} singular="proveedor"/>}
        {at==='contacts'&&<ContactMgr contacts={contacts} saveCont={saveCont} notify={notify}/>}
        {at==='pending'&&(
          <div>
            {pending.length===0?<p style={{color:'#9ca3af',textAlign:'center',padding:'20px 0'}}>Sin solicitudes pendientes</p>:
              pending.map(req=>(
                <div key={req.id} style={{padding:16,border:'1px solid #e5e7eb',borderRadius:8,marginBottom:12,background:'#fafafa'}}>
                  <div style={{display:'flex',justifyContent:'space-between',alignItems:'flex-start',gap:12,flexWrap:'wrap'}}>
                    <div>
                      <div style={{fontWeight:700,fontSize:14}}>{req.name}</div>
                      <div style={{fontSize:12,color:'#6b7280'}}>{req.email}</div>
                      {req.reason&&<div style={{fontSize:12,color:'#374151',marginTop:4}}>Motivo: {req.reason}</div>}
                      <div style={{fontSize:11,color:'#9ca3af',marginTop:2}}>Solicitado: {new Date(req.requestedAt).toLocaleDateString('es-PE')}</div>
                    </div>
                    <div style={{display:'flex',gap:8,alignItems:'center',flexWrap:'wrap'}}>
                      <input value={approvePw[req.id]||''} onChange={e=>setAPw(p=>({...p,[req.id]:e.target.value}))} placeholder="Contraseña a asignar" style={{padding:'7px 10px',border:'1.5px solid #d1d5db',borderRadius:6,fontSize:12,fontFamily:'inherit',minWidth:170}}/>
                      <button onClick={()=>onApprove(req.id,approvePw[req.id])} style={{padding:'7px 14px',background:'#22c55e',color:'white',border:'none',borderRadius:6,cursor:'pointer',fontSize:12,fontWeight:700,fontFamily:'inherit'}}>✓ Aprobar</button>
                      <button onClick={()=>onReject(req.id)} style={{padding:'7px 14px',background:'#ef4444',color:'white',border:'none',borderRadius:6,cursor:'pointer',fontSize:12,fontWeight:700,fontFamily:'inherit'}}>✕ Rechazar</button>
                    </div>
                  </div>
                </div>
              ))
            }
          </div>
        )}
        {at==='users'&&(
          <div style={{overflowX:'auto'}}>
            {users.length===0?<p style={{color:'#9ca3af',textAlign:'center'}}>Sin usuarios registrados</p>:
              <table style={{width:'100%',borderCollapse:'collapse'}}>
                <thead><tr style={{background:'#f8fafc',borderBottom:'2px solid #e5e7eb'}}>{['Nombre','Correo','Rol','Registro'].map(h=><th key={h} style={{padding:'10px 12px',textAlign:'left',fontWeight:800,fontSize:12,color:'#374151'}}>{h}</th>)}</tr></thead>
                <tbody>{users.map((u,i)=>(
                  <tr key={u.id} style={{borderBottom:'1px solid #f3f4f6',background:i%2===0?'white':'#fafafa'}}>
                    <td style={{padding:'10px 12px',fontSize:13,fontWeight:600}}>{u.name}</td>
                    <td style={{padding:'10px 12px',fontSize:13,color:'#2563eb'}}>{u.email}</td>
                    <td style={{padding:'10px 12px'}}><span style={{background:u.role==='admin'?'#fef3c7':'#dbeafe',color:u.role==='admin'?'#92400e':'#1e40af',padding:'2px 8px',borderRadius:12,fontSize:11,fontWeight:700}}>{u.role==='admin'?'👑 Admin':'👤 Usuario'}</span></td>
                    <td style={{padding:'10px 12px',fontSize:12,color:'#6b7280'}}>{new Date(u.createdAt).toLocaleDateString('es-PE')}</td>
                  </tr>
                ))}</tbody>
              </table>
            }
          </div>
        )}
      </div>
    </div>
  );
}

function ListMgr({items,onSave,notify,singular}){
  const [val,setVal]=useState('');
  const [editing,setEditing]=useState(null);
  const [editV,setEV]=useState('');
  const is={padding:'9px 11px',border:'1.5px solid #d1d5db',borderRadius:6,fontSize:13,outline:'none',flex:1,fontFamily:'inherit',color:'#111',background:'white'};
  const add=()=>{const v=val.trim();if(!v)return;if(items.includes(v)){notify('Ya existe ese '+singular,'warn');return;}onSave([...items,v]);setVal('');notify(singular.charAt(0).toUpperCase()+singular.slice(1)+' agregado/a');};
  const del=name=>{onSave(items.filter(x=>x!==name));notify('Eliminado');};
  const saveEdit=()=>{const v=editV.trim();if(!v)return;onSave(items.map(x=>x===editing?v:x));setEditing(null);notify('Actualizado');};
  return(
    <div>
      <div style={{display:'flex',gap:8,marginBottom:16}}>
        <input value={val} onChange={e=>setVal(e.target.value)} onKeyDown={e=>e.key==='Enter'&&add()} placeholder={'Nuevo '+singular+'...'} style={is}/>
        <button onClick={add} style={{padding:'9px 16px',background:BL,color:'white',border:'none',borderRadius:6,cursor:'pointer',fontWeight:800,fontSize:17,fontFamily:'inherit'}}>＋</button>
      </div>
      <div style={{display:'flex',flexDirection:'column',gap:7,maxHeight:350,overflowY:'auto'}}>
        {items.length===0&&<p style={{color:'#9ca3af',fontSize:13,textAlign:'center',padding:'20px 0'}}>Sin registros. Agrega el primero.</p>}
        {items.map(item=>(
          editing===item?(
            <div key={item} style={{display:'flex',gap:7}}>
              <input value={editV} onChange={e=>setEV(e.target.value)} onKeyDown={e=>e.key==='Enter'&&saveEdit()} style={is} autoFocus/>
              <button onClick={saveEdit} style={{padding:'8px 12px',background:'#22c55e',color:'white',border:'none',borderRadius:6,cursor:'pointer',fontWeight:800}}>✓</button>
              <button onClick={()=>setEditing(null)} style={{padding:'8px 12px',background:'#e5e7eb',color:'#374151',border:'none',borderRadius:6,cursor:'pointer'}}>✕</button>
            </div>
          ):(
            <div key={item} style={{display:'flex',alignItems:'center',gap:8,padding:'10px 12px',background:'#f8fafc',borderRadius:7,border:'1px solid #e5e7eb'}}>
              <span style={{flex:1,fontSize:13,color:'#374151',fontWeight:500}}>{item}</span>
              <button onClick={()=>{setEditing(item);setEV(item);}} style={{padding:'4px 10px',background:'#dbeafe',color:'#1e40af',border:'none',borderRadius:5,cursor:'pointer',fontSize:12,fontWeight:700,fontFamily:'inherit'}}>✏️ Editar</button>
              <button onClick={()=>del(item)} style={{padding:'4px 10px',background:'#fee2e2',color:'#dc2626',border:'none',borderRadius:5,cursor:'pointer',fontSize:12,fontWeight:700,fontFamily:'inherit'}}>🗑</button>
            </div>
          )
        ))}
      </div>
    </div>
  );
}

function ContactMgr({contacts,saveCont,notify}){
  const [name,setName]=useState('');
  const [email,setEmail]=useState('');
  const [editing,setEditing]=useState(null);
  const [editName,setEN]=useState('');
  const [editEmail,setEE]=useState('');
  const is={padding:'9px 11px',border:'1.5px solid #d1d5db',borderRadius:6,fontSize:13,outline:'none',fontFamily:'inherit',color:'#111',background:'white',flex:1};
  const add=()=>{if(!name.trim()||!email.trim()){notify('Completa nombre y correo','warn');return;}if(contacts.length>=3){notify('Máximo 3 contactos','warn');return;}saveCont([...contacts,{id:uid(),name:name.trim(),email:email.trim()}]);setName('');setEmail('');notify('Contacto agregado');};
  const del=id=>{saveCont(contacts.filter(c=>c.id!==id));notify('Contacto eliminado');};
  const saveEdit=()=>{if(!editName.trim()||!editEmail.trim())return;saveCont(contacts.map(c=>c.id===editing?{...c,name:editName.trim(),email:editEmail.trim()}:c));setEditing(null);notify('Contacto actualizado');};
  return(
    <div>
      <p style={{fontSize:12,color:'#6b7280',margin:'0 0 14px'}}>Máximo 3 contactos administradores. Se muestran a usuarios sin acceso corporativo.</p>
      {contacts.length<3&&(
        <div style={{display:'flex',gap:8,marginBottom:16,flexWrap:'wrap'}}>
          <input value={name} onChange={e=>setName(e.target.value)} placeholder="Nombre del contacto" style={is}/>
          <input type="email" value={email} onChange={e=>setEmail(e.target.value)} placeholder="correo@sodimac.com" style={is}/>
          <button onClick={add} style={{padding:'9px 16px',background:BL,color:'white',border:'none',borderRadius:6,cursor:'pointer',fontWeight:800,fontSize:17,fontFamily:'inherit'}}>＋</button>
        </div>
      )}
      <div style={{display:'flex',flexDirection:'column',gap:8}}>
        {contacts.length===0&&<p style={{color:'#9ca3af',fontSize:13,textAlign:'center',padding:'20px 0'}}>Sin contactos configurados.</p>}
        {contacts.map((c,i)=>(
          editing===c.id?(
            <div key={c.id} style={{display:'flex',gap:8,flexWrap:'wrap'}}>
              <input value={editName} onChange={e=>setEN(e.target.value)} style={is}/>
              <input type="email" value={editEmail} onChange={e=>setEE(e.target.value)} style={is}/>
              <button onClick={saveEdit} style={{padding:'8px 12px',background:'#22c55e',color:'white',border:'none',borderRadius:6,cursor:'pointer',fontWeight:800}}>✓</button>
              <button onClick={()=>setEditing(null)} style={{padding:'8px 12px',background:'#e5e7eb',color:'#374151',border:'none',borderRadius:6,cursor:'pointer'}}>✕</button>
            </div>
          ):(
            <div key={c.id} style={{display:'flex',alignItems:'center',gap:12,padding:'12px 14px',background:'#f8fafc',borderRadius:8,border:'1px solid #e5e7eb'}}>
              <div style={{background:'#dbeafe',color:'#1e40af',borderRadius:'50%',width:30,height:30,display:'flex',alignItems:'center',justifyContent:'center',fontWeight:800,fontSize:13,flexShrink:0}}>{i+1}</div>
              <div style={{flex:1}}>
                <div style={{fontWeight:700,fontSize:13}}>{c.name}</div>
                <a href={'mailto:'+c.email} style={{fontSize:12,color:'#2563eb',textDecoration:'none'}}>📧 {c.email}</a>
              </div>
              <button onClick={()=>{setEditing(c.id);setEN(c.name);setEE(c.email);}} style={{padding:'4px 10px',background:'#dbeafe',color:'#1e40af',border:'none',borderRadius:5,cursor:'pointer',fontSize:12,fontWeight:700,fontFamily:'inherit'}}>✏️</button>
              <button onClick={()=>del(c.id)} style={{padding:'4px 10px',background:'#fee2e2',color:'#dc2626',border:'none',borderRadius:5,cursor:'pointer',fontSize:12,fontWeight:700,fontFamily:'inherit'}}>🗑</button>
            </div>
          )
        ))}
      </div>
    </div>
  );
}

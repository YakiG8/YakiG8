  const sf=(k,v)=>setFil(x=>({...x,[k]:v}));

  const filtered=records.filter(r=>{
    if(f.tienda&&r.tienda!==f.tienda)return false;
    if(f.proveedor&&r.proveedor!==f.proveedor)return false;
    if(f.nroGuia&&!r.nroGuia?.toLowerCase().includes(f.nroGuia.toLowerCase()))return false;
    if(f.nroCartaPorte&&!r.nroCartaPorte?.toLowerCase().includes(f.nroCartaPorte.toLowerCase()))return false;
    if(f.nc&&!r.nc?.toLowerCase().includes(f.nc.toLowerCase()))return false;
